

@{
    Layout = "~/Views/Shared/_LayoutGen.cshtml";
}
@section styles {
    <style>

        .select2-container--default .select2-selection--single {
            background-color: #fff3f8; /* Color de fondo original */
        }
        /* Estilos CSS */
        .highlight {
            background-color: #fff3f8;
           /*  lightyellow */
        }

        /* Estilos opcionales para personalizar más la modal */
        /* Estilo adicional para la modal y los botones */
        /* Estilo adicional para el botón de WhatsApp */
        /* Estilo para la cabecera de la modal */
        #recogerModal .modal-header {
            background-image: linear-gradient(267deg, #681976 11%, #010454 82%) !important; /* Gradiente morado */
            text-align: center;
            padding: 20px;
        }

        #recogerModal .modal-title {
            font-family: 'Arial', sans-serif;
            font-size: 28px; /* Tamaño más grande */
            font-weight: bold;
            color: white;
            margin: 0;
            text-align: center;
            width: 100%;
        }

        /* Otros estilos para los botones y modal */
        #recogerModal .modal-content {
            background-color: #fce4f4;
            border: 2px solid #d4af37;
        }

        #recogerModal #whatsappBtn {
            background-color: #25D366; /* Verde WhatsApp */
            color: white;
            border: none;
        }

            #recogerModal #whatsappBtn:hover {
                background-color: #128C7E;
            }

        #recogerModal #confirmarBtn {
            border-color: #d4af37;
            color: #60076a;
        }

            #recogerModal #confirmarBtn:hover {
                background-color: #b530e2;
                color: white;
                border-color: #b530e2;
            }
        /* Estilos para la cabecera de la modal */
        /* Estilos para la cabecera de la modal */
        #paymentModal .modal-header {
            background-image: linear-gradient(267deg, #681976 11%, #010454 82%) !important; /* Gradiente atractivo morado */
            text-align: center;
            padding: 20px;
        }

        #paymentModal .modal-title {
            font-family: 'Arial', sans-serif;
            font-size: 24px; /* Tamaño de letra más grande */
            font-weight: bold;
            color: white;
            margin: 0;
            text-align: center;
            width: 100%;
        }

        /* Estilo para los botones */
        #paymentModal .modal-body button {
            font-weight: bold;
            border-radius: 25px;
            margin-top: 15px;
            width: 80%;
            padding: 12px; /* Ajuste de padding para que los botones se vean más grandes */
        }

        /* Botón de Mercado Pago (azul claro) */
        #paymentModal #mercadoPagoBtn {
            background-color: #007eb5 !important; /* Azul claro */
            color: white;
            border: none;
        }

            #paymentModal #mercadoPagoBtn:hover {
                background-color: #b530e2 !important; /* Verde claro cuando pasa el mouse */
            }

        /* Botón para recoger en el negocio */
        #paymentModal #recogerBtn {
            background-color: transparent;
            border: 2px solid #d4af37; /* Dorado para el borde */
            color: #681976; /* Morado para el texto */
        }

            #paymentModal #recogerBtn:hover {
                background-color: #b530e2; /* Fondo morado cuando pasa el mouse */
                color: white; /* Cambia la letra a blanco */
                border-color: #b530e2; /* Borde morado cuando pasa el mouse */
            }

        /* Enlace de WhatsApp */
        #paymentModal #whatsappLink a {
            background-color: #b530e2; /* Verde WhatsApp */
            color: white;
            border-radius: 25px;
            width: 80%;
            display: inline-block;
            text-align: center;
        }

            #paymentModal #whatsappLink a:hover {
                background-color: #128C7E;
            }

        /* Alineación y estilo de los textos */
        #paymentModal .modal-body p {
            font-size: 16px;
            color: #444;
            margin-bottom: 10px;
        }



 
    </style>
}

