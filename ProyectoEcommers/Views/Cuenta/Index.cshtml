        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const sliderContainer = document.getElementById('PanelEncuesta');
                const slides = sliderContainer.querySelectorAll('.single-slider');
                let currentSlide = 0;
                const slideInterval = 4000; // Time in milliseconds (e.g., 4000ms = 4 seconds per slide)

                function showSlide(index) {
                    slides.forEach(slide => {
                        slide.classList.remove('active');
                    });
                    slides[index].classList.add('active');
                }

                function nextSlide() {
                    currentSlide = (currentSlide + 1) % slides.length;
                    showSlide(currentSlide);
                }

                showSlide(currentSlide);
                setInterval(nextSlide, slideInterval);

                sliderContainer.classList.remove('hidden'); // Ensure slider is visible
            });
        </script>

    }

