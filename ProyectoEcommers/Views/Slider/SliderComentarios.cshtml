<div class="card border-success card card-outline-info">
    <div class="card-header d-flex align-items-center">
        <h4 class="m-b-0 text-white"><i class="mr-2 fas fa-balance-scale text-white"></i>Registro Slider Inferior - Por favor solo anexe 6 imagenes</h4>
        <div class="card-actions ml-auto" style="margin-right: 21px !important;">
            <a class="" data-action="collapse"><i class="ti-minus yellow" style="font-weight: bold;font-size: 15px;"></i></a>
            <a class="btn-minimize" data-action="expand"><i class="mdi mdi-arrow-expand yellow" style="font-weight: bold;font-size: 15px;"></i></a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="row">
            <div class="col-md-6 MargFloatBoos">
                <div class="form-group has-float-label">
                    <input tabindex="2" id="txtFechaComentario" type="text" style="width:100%" placeholder="Fecha" class="Calendario" />
                    <label class="Labels">FechaComentario:</label>
                </div>
            </div>
            <div class="col-md-6 MargFloatBoos">
                <div class="form-group has-float-label">
                    <input tabindex="2" name="txtTituloComentario" type="text" id="txtTituloComentario" autocomplete="off" placeholder=" " class="form-control InputPading" />
                    <label class="Labels">Titulo Comentario:</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label class="Label">Comentario:</label>
                    <textarea class="form-control" placeholder=" " rows="5" id="txtComentario" name="txtComentario" maxlength="500" style="height: 130px !important; text-align:justify; margin-bottom: 0px;" tabindex="4"></textarea>

                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <fieldset>
                        <legend style="width: calc(13.5em + 0.75rem + -7px) !important;">Opción Cargar Slider</legend>
                        <br />
                        <div class="row">
                            <div class="col-md-12 offset-md-5">
                                <div id="divDocumento" class="input-group input-file" name="Fichier" style="margin-top: -25px; margin-bottom: 14px;">
                                    <input type="file" id="inputFile" class="btn bg-warning btn-flat btn-choose" style="border-radius: 4px 0px 0px 4px;" placeholder='cargar por archivo jpg' />
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <div class="col-md-12 text-center">
                <button tabindex="10" type="button" id="btnGrabar" onclick="Ins_ImagenSlider(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad"><span class="fa fa-floppy-o faa-wrench animated"></span> Guardar</button>
                <button tabindex="13" type="button" id="btnLimpiar" onclick="Limpiar(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-limpiar" title="Limpiar la consulta"><span class="fa ico_limpiar faa-ring animated"></span> Limpiar</button>
            </div>
        </div>
    </div>
</div>
<div class="card border-success">
    <div class="card-body collapse show">
