<body data-bs-spy="scroll" data-bs-target="#mainNav" data-bs-offset="74">
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark fixed-top navbar-shrink" style="background-color:black " id="mainNav">
            <div class="container">
                <a class="navbar-brand" href="#page-top"><img src="img/Logo.png" alt="..." /></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                    Menu
                    <i class="fas fa-bars ms-1"></i>
                </button>
                <div class="collapse navbar-collapse" id="navbarResponsive">
                    <ul class="navbar-nav text-uppercase ms-auto py-3 py-lg-0">                     
                        <li class="nav-item"><a class="nav-link" href="#page-top">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" href="#Mariachi">Mariachi en vivo</a></li>
                        <li class="nav-item"><a class="nav-link" href="#portfolio2">Próximos Eventos</a></li>
                        <li class="nav-item"><a class="nav-link" href="#services">Servicios</a></li>
                        <li class="nav-item"><a class="nav-link" href="#portfolio">Galeria</a></li>                    
                        <li class="nav-item"><a class="nav-link" href="#team">Ubicación</a></li>
                        <li class="nav-item"><a class="nav-link" href="#contact">Comentarios</a></li>
                        <li class="nav-item"><a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#cartaMariaBonita">Carta</a></li>
                  @*       <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Iniciar Sesión</a></li> *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cuenta" asp-action="Login">
                                <img src="~/img/Inicio.png" alt="" style="width: 30px; height: 30px;">
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()

        </main>

        <div id="whatsapp-widget">
            <a href="#" onclick="toggleChatWidget(event)">
                <div class="circle"></div> <img class="whatsapp-icon" src="~/img/whatsapp-icon.png" alt="WhatsApp">
                <p>Reserva</p>
            </a>
        </div>

        <div id="chat-widget" class="chat-widget" style="display: none;">
            <div class="chat-header">
                <span><img src="~/img/Logo.png" alt="logo" style="width: 39px;"> Bienvenido al Chat de WhatsApp </span>
                <button onclick="toggleChatWidget(event)">×</button>
            </div>
            <div class="chat-body">
                <p>¡Reservas disponibles aquí!. Te responderemos en menos de 5 minutos.</p>
            </div>
            <div class="card-footer">
                <div class="col-md-12 text-center">
                    <button tabindex="1003" type="button" id="btnIniciarChat" style="border-radius: 3px 3px 3px 3px !important;" class="btn btn-eliminar btn btn-outline-success" title="Iniciar Chat"><span class="far fa-paper-plane animated"></span> Iniciar Chat</button>
                </div>
            </div>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Maria Bonita - <a asp-area="" asp-page="/Privacy">Todos los Derechos Reservados</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

