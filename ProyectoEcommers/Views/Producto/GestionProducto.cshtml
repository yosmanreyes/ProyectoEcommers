@{
    ViewData["Title"] = "Gestionar productos";
}

@section scripts{
   

    <script>
        var UrlInsProducto = "@Url.Action("Ins_Producto", "Producto", new { Area = "" })";
        var UrlGetEmpleadoIntel = "@Url.Action("F_GetEmpleadoIntel", "Empleados", new { Area = "" })";
        var UrlGetDominios = "@Url.Action("ConsultaDominios", "Cuenta", new { Area = "" })";
        var UrlConsultaProducto = "@Url.Action("F_GetProductosGrilla", "Producto", new { Area = "" })";
        var UrlConsultaProductoDesactivados = "@Url.Action("F_GetProductosGrillaDesactivado", "Producto", new { Area = "" })";
        var UrlUpdateProducto = "@Url.Action("UpdateProducto", "Producto", new { Area = "" })";
        var UrlConsultaImagen = "@Url.Action("F_GetImagenGrilla", "Producto", new { Area = "" })";
        var UrlUpdateImagen = "@Url.Action("UpdateImagen", "Producto", new { Area = "" })";
        var UrlReporteExcelGeneralP = "@Url.Action("ExcelProductoTotal", "Producto", new { Area = "" })";
        var UrlReporteExcelVigentes = "@Url.Action("ExcelProductoVigentes", "Producto", new { Area = "" })";
        var UrlReporteExcelDesactivados = "@Url.Action("ExcelProductoDesactivados", "Producto", new { Area = "" })";
        var UrlImgProductos = "@Url.Content("~/img/Productos/")";
        var UrlAlertSucess = "@Url.Content("~/img/alertsucess.png")";
        var UrlAlertError = "@Url.Content("~/img/AlertError.png")";
    </script>
    <script src="~/areas/admin/productos.js?Versionx=10"></script>
    <script type='text/javascript'>
        $(document).ready(function () {
            GetConsultaDominios();
        });
    </script>
}
@Html.AntiForgeryToken()
<section class="content-header"></section>
<input ID="IdProducto" Value="0" runat="server" class="hidden" />
<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span>Inicio</span></a></li>
            <li class="active">Gestionar producto</li>
        </ul>
    </div>
</div>
<div class="card border-success">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fa fa-pencil-square-o text-white"></i>Administración de Usuarios</h4>
        <div class="card-actions ms-auto d-flex button-group">
    
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="5" name="txtNombre" type="text" id="txtNombre" autocomplete="off" placeholder=" " class="form-control InputPading" />
                            <label class="Labels">Nombre:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="5" name="txtDescripcion" type="text" id="txtDescripcion" autocomplete="off" placeholder=" " class="form-control InputPading" />
                            <label class="Labels">Descripción:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <select class="form-control select2 InputPading" style="width:100%" id="selectMarca">
                                <option value="" selected disabled>Seleccione</option>
                            </select>
                            <label class="Labels">Marca:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <select class="form-control select2 InputPading" style="width:100%" id="selectCategoria">
                                <option value="" selected disabled>Seleccione</option>
                            </select>
                            <label class="Labels">Categoría:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="5" name="txtCantidad" type="number" id="txtCantidad" autocomplete="off" placeholder=" " class="form-control InputPading" />
                            <label class="Labels">Cantidad:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="5" name="txtPrecio" type="number" id="txtPrecio" autocomplete="off" placeholder=" " class="form-control InputPading" />
                            <label class="Labels">Precio:</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <fieldset>
                    <legend style="width: calc(13.5em + 0.75rem + -7px) !important;">Agregar imagen 1</legend>
                    <br />
                    <div id="divDocumento" class="input-group input-file" name="Fichier" style="margin-top: -25px; margin-bottom: 14px;">
                        <input type="file" id="inputFile1" class="btn bg-lila btn-flat btn-choose" style="border-radius: 6px; width:100%" placeholder='cargar por archivo jpg' />
                    </div>
                </fieldset>
            </div>
            <div class="col-md-6">
                <fieldset>
                    <legend style="width: calc(13.5em + 0.75rem + -7px) !important;">Agregar imagen 2</legend>
                    <br />
                    <div id="divDocumento" class="input-group input-file" name="Fichier" style="margin-top: -25px; margin-bottom: 14px;">
                        <input type="file" id="inputFile2" class="btn bg-lila btn-flat btn-choose" style="border-radius: 6px; width:100%" placeholder='cargar por archivo jpg' />
                    </div>
                </fieldset>
            </div>
            <div class="col-md-6">
                <fieldset>
                    <legend style="width: calc(13.5em + 0.75rem + -7px) !important;">Agregar imagen 3</legend>
                    <br />
                    <div id="divDocumento" class="input-group input-file" name="Fichier" style="margin-top: -25px; margin-bottom: 14px;">
                        <input type="file" id="inputFile3" class="btn bg-lila btn-choose" style="border-radius: 6px; width:100%" placeholder='cargar por archivo jpg' />
                    </div>
                </fieldset>
            </div>
            <div class="col-md-6">
                <fieldset>
                    <legend style="width: calc(13.5em + 0.75rem + -7px) !important;">Agregar imagen 4</legend>
                    <br />
                    <div id="divDocumento" class="input-group input-file" name="Fichier" style="margin-top: -25px; margin-bottom: 14px;">
                        <input type="file" id="inputFile4" class="btn bg-lila btn-flat btn-choose" style="border-radius: 6px; width:100%" placeholder='cargar por archivo jpg' />
                    </div>
                </fieldset>
            </div>
        </div>

        <div class="card-footer" style="margin-bottom: 10px;">
            <div class="col-md-12 text-right">
                <button tabindex="1002" type="button" id="btnLimpiar" onclick="RptExcelGeneralP(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-limpiar" title="Nuevo"><span class="fa fa-file-excel-o faa-ring animated"></span> Excel General</button>
                <button tabindex="1001" type="button" id="btnGrabar" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad" title="Guardar"><span class="fa fa-floppy-o faa-wrench animated"></span> Guardar</button>
                <button tabindex="1002" type="button" id="btnLimpiar" onclick="LimpiarIngresoProducto(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-limpiar" title="Nuevo"><span class="fa ico_limpiar faa-ring animated"></span> Nuevo</button>
                <button tabindex="1003" type="button" id="btnEliminar" onclick="EliminarProducto($('#IdProducto').val()); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-eliminar" title="Eliminar"><span class="fas fa-trash-alt faa-ring animated"></span> Eliminar</button>
            </div>
        </div>
    </div>
</div>

