@{
    ViewData["Title"] = "Gestionar productos";
}

@section scripts{
    <script src="~/areas/admin/marcacategoria.js?Versionx=10"></script>

    <script>
        var UrlInsProducto = "@Url.Action("Ins_Producto", "Producto", new { Area = "" })";
        var UrlGetEmpleadoIntel = "@Url.Action("F_GetEmpleadoIntel", "Empleados", new { Area = "" })";
        var UrlGetDominios = "@Url.Action("ConsultaDominios", "Cuenta", new { Area = "" })";
        var UrlConsultaMarca = "@Url.Action("F_GetProductosGrillaMarca", "Producto", new { Area = "" })";
        var UrlConsultaCategoria = "@Url.Action("F_GetProductosGrillaCategoria", "Producto", new { Area = "" })";
        var UrlUpdateMarca = "@Url.Action("UpdateMarca", "Producto", new { Area = "" })";
        var UrlUpdateCategoria = "@Url.Action("UpdateCategoria", "Producto", new { Area = "" })";
        var UrlAddMarca = "@Url.Action("AddMarca", "Producto", new { Area = "" })";
        var UrlAddCategoria = "@Url.Action("AddCategoria", "Producto", new { Area = "" })";
        
        //var UrlConsultaImagen = "@Url.Action("F_GetImagenGrilla", "Producto", new { Area = "" })";
        var UrlUpdateImagen = "@Url.Action("UpdateImagen", "Producto", new { Area = "" })";
    </script>
@*    <script type='text/javascript'>
